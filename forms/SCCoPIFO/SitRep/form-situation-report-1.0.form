addon    SCCoPIFO
html     form-situation-report.html
version  1.0
title    Situation Report Form
indef    a situation report form
create   SitRep sr
pdfFile  Situation_Report_v20250730.pdf

field MsgNo originMessageID
  label    "Origin Message Number"
  type     messageID
  presence required
  help     "This is the message number assigned to the message by the origin station.  Valid message numbers have the form XXX-###P, where XXX is the three-character message number prefix assigned to the station, ### is a sequence number (any number of digits), and P is an optional suffix letter.  This field is required."
  pdf      text L 223.36 R 342.16 B 713.00 T 730.96 BL 718.34
  pdf      text P 2 L 458.08 R 563.32 B 742.32 T 790.00 BL 745.50
  pdf      text P 3 L 458.08 R 563.32 B 742.32 T 790.00 BL 745.54

field DestMsgNo destinationMessageID
  label    "Destination Message Number"
  type     messageID
  pdf      text L 442.00 R 564.76 B 713.00 T 730.96 BL 718.34

field 1a. messageDate
  label    "Message Date"
  type     date
  presence required
  help     "This is the date the message was written, in MM/DD/YYYY format.  It is required."
  pdf      text L  69.80 R 122.92 B 652.40 T 676.24 BL 660.47

field 1b. messageTime
  label    "Message Time"
  type     time
  presence required
  help     "This is the time the message was written, in HH:MM format (24-hour clock).  It is required."
  pdf      text L 188.92 R 235.48 B 652.40 T 676.24 BL 660.47

field -
  label    "Message Date/Time"
  type     dateTime
  children 1a. 1b.
  presence required
  help     "This is the date and time the message was written, in MM/DD/YYYY HH:MM format (24-hour clock).  It is required."

field 5. handling
  label    Handling
  type     restricted
  value    IMMEDIATE
  choice   IMMEDIATE
  choice   PRIORITY
  choice   ROUTINE
  presence required
  help     "This is the message handling order, which specifies how fast it needs to be delivered.  Allowed values are \"ROUTINE\" (within 2 hours), \"PRIORITY\" (within 1 hour), and \"IMMEDIATE\".  This field is required."
  pdf      if 5.=IMMEDIATE then circle X 298.86 Y 665.16 R 3.9
  pdf      if 5.=PRIORITY then circle X 400.74 Y 664.92 R 3.9
  pdf      if 5.=ROUTINE then circle X 486.12 Y 664.98 R 3.8

field 7a. toICSPosition
  label    "To ICS Position"
  value    "Situational Analysis Unit"
  choice   Situational Analysis Unit
  choice   Common Operating Picture Spec.
  choice   Planning
  presence required
  width    30
  help     "This is the ICS position to which the message is addressed.  It is required."
  pdf      text L 130.84 R 281.32 B 626.00 T 647.92 BL 633.24

field 7b. toLocation
  label    "To Location"
  value    "County EOC"
  presence required
  width    32
  help     "This is the location of the recipient ICS position.  It is required."
  pdf      text L 130.84 R 281.32 B 599.60 T 621.52 BL 606.75

field 7c.
  label    "To Name"
  width    34
  help     "This is the name of the person holding the recipient ICS position.  It is optional and rarely provided."
  pdf      text L 130.84 R 280.60 B 573.20 T 595.12 BL 580.31

field 7d.
  label    "To Contact Info"
  width    29
  help     "This is contact information (phone number, email, etc.) for the receipient.  It is optional and rarely provided."
  pdf      text L 130.84 R 281.32 B 546.80 T 568.72 BL 553.97

field 8a. fromICSPosition
  label    "From ICS Position"
  presence required
  width    30
  help     "This is the ICS position of the message author.  It is required."
  pdf      text L 373.84 R 563.44 B 626.00 T 647.92 BL 633.24

field 8b. fromLocation
  label    "From Location"
  presence required
  width    32
  help     "This is the location of the message author.  It is required."
  pdf      text L 373.84 R 563.44 B 599.60 T 621.52 BL 606.75

field 8c.
  label    "From Name"
  width    34
  help     "This is the name of the message author.  It is optional and rarely provided."
  pdf      text L 373.84 R 562.72 B 573.20 T 595.12 BL 580.31

field 8d.
  label    "From Contact Info"
  width    29
  help     "This is contact information (phone number, email, etc.) for the message author.  It is optional and rarely provided."
  pdf      text L 373.84 R 563.44 B 546.80 T 568.72 BL 553.97

field 20d.
  label    "Prepared Date"
  type     date
  presence required
  help     "This is the date when the situation report was prepared.  It is required."
  pdf      text L 114.40 R 226.24 B 510.56 T 524.08 BL 514.01

field 20t.
  label    "Prepared Time"
  type     time
  presence required
  help     "This is the time of date when the situation report was prepared.  It is required."
  pdf      text L 305.92 R 563.44 B 510.56 T 524.08 BL 514.01

field -
  label    "Prepared Date/Time"
  type     dateTime
  children 20d. 20t.
  presence required
  help     "This is the date and time when the situation report was prepared, in MM/DD/YYYY HH:MM format (24-hour clock).  It is required."

field 21. messageSummary
  label    Jurisdiction
  choice   Campbell
  choice   Cupertino
  choice   Gilroy
  choice   Los Altos
  choice   Los Altos Hills
  choice   Los Gatos
  choice   Milpitas
  choice   Monte Sereno
  choice   Morgan Hill
  choice   Mountain View
  choice   Palo Alto
  choice   San Jose
  choice   Santa Clara (City)
  choice   Saratoga
  choice   Sunnyvale
  choice   Santa Clara County
  choice   County unincorporated
  presence required
  help     "This is the name of the jurisdiction reporting the situation.  It is required."
  pdf      text L 114.40 R 294.52 B 492.56 T 505.60 BL 495.45

field 22.
  label    "Incident Name"
  presence required
  width    38
  help     "This is the name of the incident for which the situation is being reported.  It is required."
  pdf      text L 376.36 R 563.44 B 492.56 T 505.60 BL 495.45

field 23.
  label    "Emergency Declaration"
  type     restricted
  choice   Unknown
  choice   Yes
  choice   No
  help     "This indicates whether a declaration of emergency has been proclaimed."
  pdf      if 23.=Unknown then circle X 192.90 Y 481.32 R 3.3
  pdf      if 23.=Yes then circle X 300.60 Y 481.62 R 3.2
  pdf      if 23.=No then circle X 408.90 Y 481.38 R 3.3

field 24.
  label    "EOC Activation"
  type     restricted
  choice   Normal
  choice   Duty Officer
  choice   Monitor
  choice   Partial
  choice   Full
  help     "This indicates the jurisdiction EOC's activation level."
  pdf      if 24.=Normal then circle X 157.20 Y 464.04 R 3.2
  pdf      if 24.="Duty Officer" then circle X 264.54 Y 463.98 R 3.3
  pdf      if 24.=Monitor then circle X 409.14 Y 463.74 R 3.3
  pdf      if 24.=Partial then circle X 156.90 Y 448.92 R 3.3
  pdf      if 24.=Full then circle X 264.54 Y 448.62 R 3.3

field 25.
  label    "Incident Description"
  type     multiline
  width    108
  help     "This is a description of the incident."
  pdf      text L  40.64 R 563.44 B 363.20 T 425.08 A lT

field 26. defaultBody
  label    "Additional Incident Information"
  type     multiline
  width    108
  help     "This field provides additional information about the incident."
