field 30.
  label    Priority
  type     restricted
  choice   Urgent
  choice   High
  choice   Medium
  choice   Low
  help     "This is the priority of the resource request.  Urgent means as soon as possible.  High means within 24 hours.  Medium means within 1-2 days.  Low means within 2-3 days.  The priority is required."
  pdf      if 30.=Urgent then circle P 2 X 120.90 Y 703.20 R 3.9
  pdf      if 30.=Medium then circle P 2 X 301.32 Y 703.26 R 4
  pdf      if 30.=High then circle P 2 X 121.08 Y 688.02 R 4
  pdf      if 30.=Low then circle P 2 X 301.50 Y 688.02 R 4

field 40.
  label    "Requested By Name"
  presence required
  width    30
  help     "This is the name of the person requesting the resources.  It is required."
  pdf      text P 2 L 151.96 R 301.84 B 633.80 T 646.84 BL 636.50

field 40s.
  label    "with signature"
  type     checkbox
  help     "This indicates whether the original resource request form was signed."
  pdf      if 40s. then text S "(with signature)" P 2 L 406.96 R 563.44 B 633.80 T 646.84 BL 636.50

field 41.
  label    "Requested By Phone"
  type     phoneNumber
  presence required
  help     "This is the phone number of the person requesting the resources.  It is required."
  pdf      text P 2 L 151.96 R 301.84 B 615.80 T 629.32 BL 618.73

field 42.
  label    "Requested By Email"
  presence required
  width    32
  help     "This is the email address of the person requesting the resources.  It is required."
  pdf      text P 2 L 406.96 R 563.44 B 615.80 T 629.32 BL 618.73

field 43.
  label    "Requested By Position"
  presence required
  width    85
  help     "This is the position held by the person requesting the resources.  It is required."
  pdf      text P 2 L 151.96 R 563.44 B 597.80 T 611.32 BL 600.93

field 50.
  label    "Related to Jurisdiction Incident?"
  type     restricted
  choice   Yes
  choice   No
  presence required
  help     "This indicates whether the resource request is related to a current jurisdiction activation.  It is required."
  pdf      if 50.=Yes then circle P 2 X 372.90 Y 560.16 R 3.9
  pdf      if 50.=No then circle P 2 X 408.90 Y 560.16 R 4

field 51.
  label    "Name of Jurisdiction's Incident"
  presence if 50.=Yes then required else blocked
  width    54
  help     "This is the name of the current jurisdiction incident that this resource request relates to.  It is required if \"Relates to Jurisdiction Incident\" is \"Yes\", otherwise not allowed."
  pdf      text P 2 L 300.64 R 562.84 B 532.52 T 548.32 BL 536.76

field 52.
  label    "Related to County Incident?"
  type     restricted
  choice   Yes
  choice   No
  presence required
  help     "This indicates whether the resource request is related to a current county activation.  It is required."
  pdf      if 52.=Yes then circle P 2 X 372.90 Y 521.88 R 3.9
  pdf      if 52.=No then circle P 2 X 408.90 Y 521.88 R 4

field 53.
  label    "Name of County's Incident"
  presence if 52.=Yes then required else blocked
  width    54
  help     "This is the name of the current county incident that this resource request relates to.  It is required if \"Relates to County Incident\" is \"Yes\", otherwise not allowed."
  pdf      text P 2 L 300.64 R 562.96 B 496.52 T 510.04 BL 499.49

field 60. defaultBody
  label    Comments
  type     multiline
  width    108
  help     "This field contains comments about the resource request."
  pdf      text P 2 L  40.64 R 563.44 B 388.52 T 465.04 A lt

field OpRelayRcvd
  label    "Operator: Relay Received"
  width    36
  help     "This is the name of the station from which this message was directly received.  It is filled in for messages that go through a relay station."
  pdf      text P 2 L 109.12 R 320.08 B 342.08 T 356.56 BL 345.53

field OpRelaySent
  label    "Operator: Relay Sent"
  width    36
  help     "This is the name of the station to which this message was directly sent.  It is filled in for messages that go through a relay station."
  pdf      text P 2 L 355.24 R 564.28 B 342.08 T 356.56 BL 345.53

field OpName operatorName
  label    "Operator: Name"
  presence required
  pdf      text P 2 L  75.04 R 195.76 B 323.24 T 337.60 BL 326.60

field OpCall operatorCall
  label    "Operator: Call Sign"
  presence required
  pdf      text P 2 L 248.08 R 330.76 B 323.24 T 337.60 BL 326.60

field -
  label    Operator
  type     join
  children OpName OpCall

