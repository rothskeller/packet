addon    SCCoPIFO
html     form-resource-request.html
version  1.0
title    Resource Request Form
indef    a resource request form
create   ResReq rr
pdfFile  Resource_Request_v20250804.pdf

field MsgNo originMessageID
  label    "Origin Message Number"
  type     messageID
  presence required
  help     "This is the message number assigned to the message by the origin station.  Valid message numbers have the form XXX-###P, where XXX is the three-character message number prefix assigned to the station, ### is a sequence number (any number of digits), and P is an optional suffix letter.  This field is required."
  pdf      text L 217.96 R 339.76 B 726.44 T 744.52 BL 731.79
  pdf      text P 2 L 458.08 R 563.44 B 742.32 T 790.00 BL 745.47

field DestMsgNo destinationMessageID
  label    "Destination Message Number"
  type     messageID
  pdf      text L 439.60 R 564.76 B 726.44 T 744.52 BL 731.79

field 1a. messageDate
  label    "Message Date"
  type     date
  presence required
  help     "This is the date the message was written, in MM/DD/YYYY format.  It is required."
  pdf      text L  71.32 R 121.24 B 672.68 T 687.04 BL 676.18

field 1b. messageTime
  label    "Message Time"
  type     time
  presence required
  help     "This is the time the message was written, in HH:MM format (24-hour clock).  It is required."
  pdf      text L 185.92 R 236.32 B 672.68 T 687.04 BL 676.18

field -
  label    "Message Date/Time"
  type     dateTime
  children 1a. 1b.
  presence required
  help     "This is the date and time the message was written, in MM/DD/YYYY HH:MM format (24-hour clock).  It is required."

field 5. handling
  label    Handling
  type     restricted
  choice   IMMEDIATE
  choice   PRIORITY
  choice   ROUTINE
  presence required
  help     "This is the message handling order, which specifies how fast it needs to be delivered.  Allowed values are \"ROUTINE\" (within 2 hours), \"PRIORITY\" (within 1 hour), and \"IMMEDIATE\".  This field is required."
  pdf      if 5.=IMMEDIATE then circle X 302.76 Y 679.38 R 3.9
  pdf      if 5.=PRIORITY then circle X 404.88 Y 679.38 R 4
  pdf      if 5.=ROUTINE then circle X 488.40 Y 679.38 R 4

field 7a. toICSPosition
  label    "To ICS Position"
  value    "Resource Status & Tracking Unit"
  choice   Resource Status & Tracking Unit
  choice   Supply Branch
  choice   Logistics
  presence required
  width    30
  help     "This is the ICS position to which the message is addressed.  It is required."
  pdf      text L 133.60 R 252.88 B 653.72 T 668.20 BL 657.11

field 7b. toLocation
  label    "To Location"
  value    "County EOC"
  presence required
  width    32
  help     "This is the location of the recipient ICS position.  It is required."
  pdf      text L 133.60 R 252.88 B 634.88 T 649.24 BL 638.45

field 7c.
  label    "To Name"
  width    34
  help     "This is the name of the person holding the recipient ICS position.  It is optional and rarely provided."
  pdf      text L 133.60 R 252.88 B 615.92 T 630.40 BL 619.57

field 7d.
  label    "To Contact Info"
  width    29
  help     "This is contact information (phone number, email, etc.) for the receipient.  It is optional and rarely provided."
  pdf      text L 133.60 R 252.88 B 597.08 T 611.44 BL 600.66

field 8a. fromICSPosition
  label    "From ICS Position"
  presence required
  width    30
  help     "This is the ICS position of the message author.  It is required."
  pdf      text L 352.72 R 563.44 B 653.72 T 668.20 BL 657.11

field 8b. fromLocation
  label    "From Location"
  presence required
  width    32
  help     "This is the location of the message author.  It is required."
  pdf      text L 352.72 R 563.44 B 634.88 T 649.24 BL 638.45

field 8c.
  label    "From Name"
  width    34
  help     "This is the name of the message author.  It is optional and rarely provided."
  pdf      text L 352.72 R 563.44 B 615.92 T 630.40 BL 619.57

field 8d.
  label    "From Contact Info"
  width    29
  help     "This is contact information (phone number, email, etc.) for the message author.  It is optional and rarely provided."
  pdf      text L 352.72 R 563.44 B 597.08 T 611.44 BL 600.66

field 20. messageSummary
  label    Title
  presence required
  width    102
  help     "This is the title of the resource request.  It should be unique among all resource requests from the jurisdiction.  It is required."
  pdf      text L 101.20 R 563.44 B 559.76 T 573.28 BL 562.62

field 21.
  label    Jurisdiction
  choice   Campbell
  choice   Cupertino
  choice   Gilroy
  choice   Los Altos
  choice   Los Altos Hills
  choice   Los Gatos
  choice   Milpitas
  choice   Monte Sereno
  choice   Morgan Hill
  choice   Mountain View
  choice   Palo Alto
  choice   San Jose
  choice   Santa Clara (City)
  choice   Saratoga
  choice   Sunnyvale
  choice   Santa Clara County
  choice   County unincorporated
  presence required
  help     "This is the name of the jurisdiction requesting resources.  It is required."
  pdf      text L 101.20 R 563.44 B 541.28 T 554.80 BL 544.32

field 22d.
  label    Date
  type     date
  presence required
  help     "This is the date of the resource request.  It is required."
  pdf      text L 101.20 R 301.60 B 522.80 T 536.32 BL 525.81

field 22t.
  label    Time
  type     time
  presence required
  help     "This is the time of day of the resource request.  It is required."
  pdf      text L 339.52 R 563.44 B 522.80 T 536.32 BL 525.81

field -
  label    Date/Time
  type     dateTime
  children 22d. 22t.
  presence required
  help     "This is the date and time of the resource request, in MM/DD/YYYY HH:MM format (24-hour clock).  It is required."

field 23n.
  label    "Item 1: Item Name"
  presence required
  width    52
  help     "This is the name of the item being requested."
  pdf      text L 152.08 R 406.12 B 504.32 T 517.84 BL 507.29

field 23q.
  label    "Item 1: Quantity Requested"
  type     cardinalNumber
  presence required
  width    10
  help     "This is the quantity of the item being requested.  It is required when there is an item name, otherwise not allowed."
  pdf      text L 512.20 R 563.44 B 504.32 T 517.84 BL 507.29

field 23d.
  label    "Item 1: Description"
  type     multiline
  width    85
  help     "This is a description of the item being requested.  It is allowed only when there is an item name."
  pdf      text L 152.08 R 563.44 B 468.32 T 499.84 BL 491.26

field 23i.
  label    "Item 1: Demobilization"
  type     restricted
  choice   Yes
  choice   No
  presence required
  help     "This indicates whether the requested item needs to be tracked for demobilization.  It is required when there is an item name, otherwise not allowed."
  pdf      if 23i.=Yes then circle X 279.30 Y 457.98 R 4
  pdf      if 23i.=No then circle X 325.98 Y 458.40 R 4

